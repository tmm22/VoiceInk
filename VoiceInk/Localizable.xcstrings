    "Adjust capitalization, punctuation, and spacing to fit the surrounding text when pasting. If context is unavailable, your text is pasted unchanged." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passt beim Einfügen Groß- und Kleinschreibung, Zeichensetzung und Abstände an den umgebenden Text an. Ist kein Kontext verfügbar, wird dein Text unverändert eingefügt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adapte les majuscules, la ponctuation et les espaces au texte environnant lors du collage. Si le contexte est indisponible, votre texte est collé sans modification."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "貼り付けるときに、前後の文章に合わせて大文字・小文字、句読点、スペースを調整します。前後の文章を読み取れない場合は、そのまま貼り付けます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
