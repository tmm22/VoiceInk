{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voiceink-asr",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "workers_dev": false,
  "preview_urls": false,
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
