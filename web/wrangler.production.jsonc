{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voiceink-web",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "no_bundle": true,
  "assets": {
    "directory": "dist/client"
  },
  "rules": [
    { "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }
  ],
  "services": [
    { "binding": "ASR", "service": "voiceink-asr" }
  ],
  "ratelimits": [
    { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } },
    { "name": "IMPORT_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "HISTORY_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
  ],
  "routes": [
    { "pattern": "v.paul.im", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
