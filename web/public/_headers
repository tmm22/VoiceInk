# Content-hashed Vinext assets are safe to keep for the lifetime of their URL.
# vinext 0.2.x emits them under /_next/static/ (chunks and css).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# These public filenames can change between deployments, so keep their browser
# lifetime short and require revalidation after they become stale.
/favicon.svg
  Cache-Control: public, max-age=3600, must-revalidate
/file.svg
  Cache-Control: public, max-age=3600, must-revalidate
/globe.svg
  Cache-Control: public, max-age=3600, must-revalidate
/window.svg
  Cache-Control: public, max-age=3600, must-revalidate
/og.png
  Cache-Control: public, max-age=3600, must-revalidate
